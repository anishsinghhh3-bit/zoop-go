{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "recorder",
  "description": "Open the recorder and operate local recording.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-state",
    "allow-stop-recording",
    "allow-list-targets",
    "allow-set-recording-settings",
    "allow-start-recording",
    "allow-copy-output",
    "allow-open-output-folder"
  ]
}
